---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import Header from "../components/Header.astro";
import { site } from "../data/site";

interface Props { title?: string; description?: string; }
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}og.svg`, Astro.site)} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "Person", name: site.name,
      url: Astro.site, jobTitle: site.title, sameAs: site.profiles.map((item) => item.href),
    })} />
  </head>
  <body style={`--penrose: url('${import.meta.env.BASE_URL}penrose.svg')`}>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content"><slot /></main>
    <footer class="site-footer shell">
      <span>© {year} {site.name}</span>
      <span>{site.location}</span>
    </footer>
  </body>
</html>

<style>
  .skip { position: fixed; top: -100px; left: 16px; z-index: 100; padding: 10px 14px; color: #08110b; background: var(--green); }
  .skip:focus { top: 12px; }
  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: clamp(48px, 8vw, 96px);
    padding-block: 20px 34px;
    border-top: 1px solid var(--line);
    color: var(--dim);
    font: .63rem var(--mono);
    text-transform: uppercase;
    letter-spacing: .08em;
  }
  @media (max-width: 720px) {
    .site-footer { flex-direction: column; gap: 8px; margin-top: 40px; padding-block: 16px 28px; }
  }
</style>
