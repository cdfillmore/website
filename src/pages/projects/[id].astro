---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
export async function getStaticPaths() { return (await getCollection("projects")).map((entry) => ({ params: { id: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.summary}><article class="project shell"><header><a href={`${import.meta.env.BASE_URL}projects/`}>← All work</a><p class="eyebrow">{entry.data.category} / {entry.data.date.getFullYear()}</p><h1>{entry.data.title}</h1><p class="lede">{entry.data.summary}</p><dl><div><dt>Role</dt><dd>{entry.data.role}</dd></div><div><dt>Tools</dt><dd>{entry.data.technologies.join(" · ")}</dd></div></dl></header><div class="body"><Content /></div></article></BaseLayout>
<style>.project{padding-block:70px 140px}.project header{max-width:980px}.project header>a{color:var(--muted);font-size:.75rem}.eyebrow{margin-top:80px}h1{margin:25px 0 35px;font:400 clamp(3.8rem,8vw,8rem)/.9 var(--serif);letter-spacing:-.05em}.lede{max-width:780px}dl{display:flex;gap:70px;margin:60px 0;border-top:1px solid var(--line);padding-top:25px}dt{color:var(--dim);font:.62rem var(--mono);text-transform:uppercase}dd{margin:8px 0 0}.body{max-width:760px;margin:100px auto 0}.body :global(h2){margin:70px 0 20px;font:400 2.4rem var(--serif)}.body :global(p){color:#bec3bf}.body :global(a){color:var(--green);text-decoration:none;border-bottom:1px solid color-mix(in srgb, var(--green) 50%, transparent);padding-bottom:1px}.body :global(a:hover){color:#d9ffd0;border-bottom-color:currentColor}.body :global(blockquote){margin:0 0 60px;border-left:2px solid var(--green);padding-left:20px;color:var(--muted)}@media(max-width:720px){dl{flex-direction:column;gap:20px}}</style>
