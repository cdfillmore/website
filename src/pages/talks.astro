---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { assetHref } from "../lib/assetHref";
const talks = (await getCollection("talks")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const format = new Intl.DateTimeFormat("en", { month: "short", year: "numeric" });
---
<BaseLayout title="Talks" description="Selected lectures, seminars, and conference talks.">
  <section class="shell section">
    <div class="section-heading">
      <p class="eyebrow">Talks / lectures</p>
      <h2>List of recent talks</h2>
    </div>
    <div class="list">
      {talks.map((talk) => (
        <article class:list={{ "has-image": Boolean(talk.data.image) }}>
          <time class="date" datetime={talk.data.date.toISOString()}>{format.format(talk.data.date)}</time>
          <div>
            <h3>{talk.data.title}</h3>
            <p>{talk.data.summary}</p>
            <em>{talk.data.venue} · {talk.data.location}</em>
          </div>
          {talk.data.image && (
            <div class="thumb">
              <img src={assetHref(Astro.url.pathname, talk.data.image)} alt="" decoding="async" />
            </div>
          )}
          <div class="external">
            {talk.data.event
              ? <a href={talk.data.event}>Event ↗</a>
              : <span class="link-slot" aria-hidden="true" />}
            {talk.data.slides
              ? <a href={assetHref(Astro.url.pathname, talk.data.slides)} target="_blank" rel="noopener noreferrer">Slides ↗</a>
              : <span class="link-slot" aria-hidden="true" />}
            {talk.data.recording
              ? <a href={assetHref(Astro.url.pathname, talk.data.recording)} target="_blank" rel="noopener noreferrer">Watch ↗</a>
              : <span class="link-slot" aria-hidden="true" />}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .list { border-top: 1px solid var(--line); }
  article { display: grid; grid-template-columns: 110px 1fr auto; gap: 30px; padding: 38px 0; border-bottom: 1px solid var(--line); align-items: center; }
  article.has-image { grid-template-columns: 110px 1fr minmax(120px, 180px) auto; }
  .date { color: var(--ink); font: .66rem var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  h3 { max-width: 780px; margin: 10px 0; font: 400 clamp(1.7rem, 3vw, 3rem)/1.05 var(--serif); }
  article p, article em { color: var(--muted); font-size: .83rem; font-style: normal; }
  .thumb { border: 1px solid var(--line); background: var(--surface); overflow: hidden; aspect-ratio: 1; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .external { display: grid; grid-template-rows: repeat(3, 1.35rem); gap: 10px; font-size: .7rem; align-self: center; color: var(--ink); }
  .external a:hover { color: var(--green); }
  .external a, .external .link-slot { display: flex; align-items: center; min-height: 1.35rem; white-space: nowrap; }
  .external .link-slot { visibility: hidden; }
  @media (max-width: 720px) {
    article, article.has-image { grid-template-columns: 1fr; gap: 10px; padding: 26px 0; }
    .thumb { max-width: 220px; }
    .external { grid-template-rows: none; grid-auto-flow: column; grid-auto-columns: max-content; gap: 12px 16px; }
    .external .link-slot { display: none; }
    h3 { margin: 8px 0 6px; font-size: 1.5rem; }
    article p, article em { font-size: .78rem; }
  }
</style>
