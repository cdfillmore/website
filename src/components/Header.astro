---
import { nav, site } from "../data/site";
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL, "/");
const href = (value: string) => `${import.meta.env.BASE_URL}${value.slice(1)}`;
const isActive = (itemHref: string) => itemHref === "/" ? path === "/" : path.startsWith(itemHref);
---
<header class="header shell">
  <a class="mark" href={href("/")} aria-label={`${site.name}, home`}>
    <span>{site.shortName}</span><i></i>
  </a>
  <nav aria-label="Primary navigation">
    {nav.map((item) => <a class:list={{ active: isActive(item.href) }} href={href(item.href)}>{item.label}</a>)}
  </nav>
</header>

<style>
  .header { min-height: 94px; display: grid; grid-template-columns: 1fr auto; align-items: center; border-bottom: 1px solid var(--line); }
  .mark { justify-self: start; display: flex; gap: 9px; align-items: center; font: 500 .85rem var(--mono); letter-spacing: -.05em; }
  .mark i { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 14px var(--green); }
  nav { display: flex; gap: clamp(20px, 3vw, 42px); }
  nav a { color: var(--muted); font-size: .74rem; letter-spacing: .04em; }
  nav a.active { color: var(--ink); }
  @media (max-width: 720px) {
    .header { min-height: 72px; gap: 12px; align-items: end; padding-block: 10px 8px; }
    nav { justify-content: flex-start; gap: 10px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; -ms-overflow-style: none; }
    nav::-webkit-scrollbar { display: none; }
    nav a { flex: 0 0 auto; padding: 7px 10px; border: 1px solid var(--line); border-radius: 999px; font-size: .62rem; white-space: nowrap; }
    nav a.active { border-color: var(--green); background: color-mix(in srgb, var(--green) 12%, transparent); }
  }
  @media (max-width: 480px) { .mark { display: none; } .header { grid-template-columns: 1fr; } nav { width: 100%; } }
</style>
